# Typography
font-family = FiraCode Nerd Font Mono
font-size = 12

# Appearance
theme = Catppuccin Mocha
background-opacity = 0.95
background-blur = true
cursor-style = block
cursor-style-blink = true

# Window
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-save-state = always

# Behavior
shell-integration = detect
copy-on-select = true
mouse-hide-while-typing = true
scrollback-limit = 10000000

# Splits
unfocused-split-opacity = 0.85

# Convenient shortcuts beyond Ghostty's defaults
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+backslash=new_split:down
keybind = alt+arrow_left=goto_split:left
keybind = alt+arrow_down=goto_split:down
keybind = alt+arrow_up=goto_split:up
keybind = alt+arrow_right=goto_split:right

# Font configuration
font-family = CaskaydiaMono Nerd Font
font-size = 9

# Window settings
window-padding-x = 14
window-padding-y = 14
window-decoration = false
background-opacity = 0.98

# Terminal settings
term = xterm-256color
command = /usr/bin/zsh -l -i

# Keybindings
keybind = f11=toggle_fullscreen
keybind = ctrl+shift+r=new_split:right
keybind = ctrl+shift+d=new_split:down
keybind = caps_lock=text:\x1b

# Color scheme from omarchy theme
background = 1a1b26
foreground = a9b1d6

# Normal colors
palette = 0=#32344a
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#ad8ee6
palette = 6=#449dab
palette = 7=#787c99

# Bright colors
palette = 8=#444b6a
palette = 9=#ff7a93
palette = 10=#b9f27c
palette = 11=#ff9e64
palette = 12=#7da6ff
palette = 13=#bb9af7
palette = 14=#0db9d7
palette = 15=#acb0d0

# Selection color
selection-background = 7aa2f7
